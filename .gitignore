# Study Agent: allow public project assets at the repository root.
# Publication policy: CONTRIBUTING.md. Do not force-add ignored assets.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/CONTRIBUTING.md
!/LICENSE
!/LICENSE.*
!/requirements.txt
!/requirements-dev.txt
!/requirements-mlx.txt
!/constraints-web-py312.txt
!/constraints-mlx-py313.txt
!/README_MAC.md
!/pytest.ini
!/run.py
!/start_app.command
!/Start Study Agent.command
!/Start Study Agent.bat
!/README_WINDOWS.md
!/CHANGELOG.md
!/SECURITY.md

!/DEFINITION_OF_DONE.md
!/AGENT.md
!/requirements-windows.txt
!/pytest.windows.ini
!/setup_windows.ps1
!/start_windows.ps1
!/test_windows.ps1
!/app/
!/static/
!/ui/
!/scripts/
!/tests/
!/eval/
!/docs/
!/corpus/
!/data/
!/.env.example

# Public product documentation; personal operational records remain local.
/docs/*
!/docs/*.md

# Source metadata only; original documents and large artifacts remain private.
/corpus/**
!/corpus/**/
!/corpus/**/*.md
!/corpus/**/*.json
!/corpus/**/*.jsonl

# Private sources, databases, vectors, models and personal data.
/src/
/data/*
!/data/README.md
!/data/offices.csv
/scratch/
/AGENTS.md
/.agents/
/.codex/
/.gemini/
/.antigravity/

# Environments, caches, logs, machine state and secrets.
.venv/
.train-venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.DS_Store
Thumbs.db
*.log
*.lock
*.pid
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
.env
.env.*
!.env.example
*.pem
*.key
*.safetensors
*.gguf

# Internal planning exports stay local.
/output/

# Windows installer manifest and helpers are shared; installers stay on each machine.
!/requirements-windows-tools.json
# One-off local trials and personal review or monitoring tasks stay local.
/scripts/curate_v9_release.py
/scripts/monitor_operations_smoke.py
/scripts/codex_review_broad_answers.py

# Share only the project rule; personal agent settings stay local.
!/.agents/
/.agents/*
!/.agents/rules/
/.agents/rules/*
!/.agents/rules/study-agent.md
/lab02/
!/eval/
/eval/*
!/eval/cases.csv
!/eval/run.py

# Calendar/timetable screenshot samples
!/calendar_src/
