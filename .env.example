# Used by scripts/dev.py and the Windows launchers. Existing process env wins.
# Demo profile always uses tests/fixtures/documents and data/team-demo.
# Local/hosted profile resolves canonical shared sources and local state (relative paths resolve from checkout root):
AGENT_SRC_DIR=src
AGENT_DATA_DIR=data
# Optional explicit overrides for shared/isolated runtime paths:
# HISTORY_DB_PATH=data/history.db
# TIMETABLE_DB_PATH=data/timetable.db
# TIMETABLE_IMAGES_DIR=data/timetable_images
# STUDY_ACCOUNTS_DIR=data/accounts
OLLAMA_BASE_URL=http://localhost:11434
# Leave DEFAULT_CHAT_MODEL unset to use the platform default.
# Mac: direct native MLX Qwen3.5 9B; Windows/Linux: local Ollama Qwen3.5 9B.
# Review old overrides during migration; hosted model APIs are prohibited.
# Leave embedding and auxiliary model overrides unset for platform defaults.
# Mac dense retrieval: bge-m3-mlx-fp16; images use the pinned native 9B base.
# Windows/Linux: local Ollama qwen3.5:9b and bge-m3; never a cloud-backed alias.
ANSWER_QUICK_MAX_TOKENS=360
ANSWER_STEPS_MAX_TOKENS=900
ANSWER_COMPARE_MAX_TOKENS=900
# MLX operational context defaults to 8192; review runtime limits before changing it.
MLX_CONTEXT_TOKENS=8192
HOST=127.0.0.1
PORT=8000
# Provider selection (leave unset for platform defaults):
# LLM_PROVIDER=ollama      # Options: 'ollama' or 'mlx'
# CHAT_BACKEND=ollama      # Options: 'ollama' or 'mlx'
# EMBED_BACKEND=ollama     # Options: 'ollama' or 'mlx'
# Optional operator-only prebuilt knowledge pack import (native BGE or Ollama pack via `scripts/dev.py --install-pack`).
# Standard `local` check/serve resolves canonical configured shared src/data paths above.
# Obtain the pack and SHA256 from a trusted release separately; never point at private training data.
# KNOWLEDGE_PACK_PATH=resources/knowledge-pack.zip
# KNOWLEDGE_PACK_SHA256=the_64_character_publisher_sha256

# Optional local LibreOffice executable for original PPTX slide previews.
# Original downloads remain available when the renderer is unavailable.
# SOFFICE_PATH=/path/to/soffice

# Hosted HTTPS, 20-user scaling, rate limiting, and per-account quota settings
# (keep real credentials and hosted secrets outside Git; loopback defaults are shown)
# STUDY_ACCOUNTS_REQUIRED=1
# STUDY_ALLOW_REGISTRATION=0
# STUDY_SECURE_COOKIES=1
# FORWARDED_ALLOW_IPS=127.0.0.1,::1
# STUDY_GPU_RUNTIME_DIR=data/runtime
# STUDY_SRC_AUTO_WATCH=0
# STUDY_MAX_INFERENCE_QUEUE=20
# STUDY_INFERENCE_QUEUE_TIMEOUT_SECONDS=25.0
# STUDY_RATE_LIMIT_ENABLED=1
# STUDY_API_RATE_LIMIT_PER_MINUTE=300
# STUDY_INFERENCE_RATE_LIMIT_PER_MINUTE=30
# STUDY_RATE_LIMIT_WINDOW_SECONDS=60.0
# STUDY_ACCOUNT_MAX_FILES=50
# STUDY_ACCOUNT_MAX_STORAGE_MB=250
# STUDY_MIN_FREE_DISK_MB=512
