# Used by scripts/dev.py and the Windows launchers. Existing process env wins.
# Demo profile always uses tests/fixtures/documents and data/team-demo.
# Local profile can use the following relative paths:
AGENT_SRC_DIR=src
AGENT_DATA_DIR=data
OLLAMA_BASE_URL=http://localhost:11434
# Leave DEFAULT_CHAT_MODEL unset to use the platform default.
# Mac: direct native MLX Qwen3.5 9B; Windows/Linux: local Ollama Qwen3.5 9B.
# Review old overrides during migration; hosted model APIs are prohibited.
# Leave embedding and auxiliary model overrides unset for platform defaults.
# Mac dense retrieval: bge-m3-mlx-fp16; images use the pinned native 9B base.
# Windows/Linux: local Ollama qwen3.5:9b and bge-m3; never a cloud-backed alias.
ANSWER_QUICK_MAX_TOKENS=360
ANSWER_STEPS_MAX_TOKENS=900
ANSWER_COMPARE_MAX_TOKENS=900
# MLX operational context defaults to 8192; review runtime limits before changing it.
MLX_CONTEXT_TOKENS=8192
HOST=127.0.0.1
PORT=8000
# Provider selection (leave unset for platform defaults):
# LLM_PROVIDER=ollama      # Options: 'ollama' or 'mlx'
# CHAT_BACKEND=ollama      # Options: 'ollama' or 'mlx'
# EMBED_BACKEND=ollama     # Options: 'ollama' or 'mlx'
# Optional publisher-provided prebuilt knowledge pack (native BGE or Ollama pack).
# Download the pack and obtain its SHA256 from the trusted release separately.
# Never point this at private training data. Leave both commented for your own library.
# KNOWLEDGE_PACK_PATH=resources/knowledge-pack.zip
# KNOWLEDGE_PACK_SHA256=the_64_character_publisher_sha256
